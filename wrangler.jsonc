{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift",
  "account_id": "f8e963c4de07dc7d399bc2126d0b18a9",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://gift.davidmackasy.workers.dev",
    "MAILGUN_DOMAIN": "budgetwithgift.com",
    "MAILGUN_REGION": "US",
    "GIFT_EMAIL_FROM": "Gift <no-reply@budgetwithgift.com>",
    "STRIPE_PRICE_MONTHLY": "price_1UJp46Ij3yjjAAsii12Robxy",
    "STRIPE_PRICE_YEARLY": "price_1UJp4mIj3yjjAAsiKIIOpCqt",
    "STRIPE_PORTAL_CONFIGURATION": "bpc_1UKpgeIj3yjjAAsiGjidUz4i"
  },
  "env": {
    "preview": {
      "name": "gift-preview",
      "triggers": {
        "crons": []
      },
      "routes": []
    }
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "budgetwithgift.com",
      "custom_domain": true
    },
    {
      "pattern": "www.budgetwithgift.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BILLING_ACCOUNTS",
        "class_name": "BillingAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "gift-billing-v1",
      "new_sqlite_classes": [
        "BillingAccount"
      ]
    }
  ]
}
