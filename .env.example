# Optional email delivery. Configure these as server-side Sites secrets.
RESEND_API_KEY=
CARRY_EMAIL_FROM=
CARRY_REMINDER_JOB_SECRET=
CARRY_APP_URL=https://carry-money-runway.maackasy.chatgpt.site
# An external scheduler must POST /api/reminders/dispatch every 15 minutes,
# with Authorization: Bearer <CARRY_REMINDER_JOB_SECRET>.
# Never place these values in NEXT_PUBLIC variables or commit actual keys.

# Set after the custom domain is verified; localhost is supported for development.
# NEXT_PUBLIC_APP_URL=https://budgetwithgift.com
