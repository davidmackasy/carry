# Copy to ignored .env.local for local development. Configure these separately at Worker runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:5173
# Server-only values for optional reminder delivery:
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
CARRY_EMAIL_FROM=
CARRY_REMINDER_JOB_SECRET=
# Stripe is not connected by the Cloudflare migration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
